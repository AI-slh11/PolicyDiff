# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/policydiff?schema=public"

# ── Auth (NextAuth v5) ───────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Magic-link email (SMTP)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@policydiff.com"

# ── S3-compatible storage ────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="policydiff-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true

# ── Redis (BullMQ job queue) ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Billing & Bank Transfer Config (No Payment Processor) ─────────
# Bank details loaded strictly from environment - NEVER hard-coded
BILLING_COMPANY_NAME="PolicyDiff Inc."
BILLING_COMPANY_ADDRESS="100 Pine Street, Suite 1250, San Francisco, CA 94111"
BILLING_SUPPORT_EMAIL="billing@policydiff.com"

BANK_BENEFICIARY_NAME="PolicyDiff Inc."
BANK_NAME="Silicon Valley Bank (A Division of First Citizens Bank)"
BANK_ACCOUNT_NUMBER="123456789012"
BANK_ROUTING_NUMBER="121000358"
BANK_SWIFT_BIC="SVBKUS6S"
BANK_ADDRESS="3003 North First Street, San Jose, CA 95134"
BANK_PAYMENT_TERMS_DAYS=7
BANK_PROCESSING_ESTIMATE="1-2 business days"

# Billing status rules (in days after invoice due date)
BILLING_REMINDER_DAYS_BEFORE_RENEWAL=5
BILLING_GRACE_PERIOD_DAYS=3
BILLING_SUSPENSION_PERIOD_DAYS=10

# Superadmin email(s) authorized for billing admin panel (comma-separated)
SUPERADMIN_EMAILS="admin@policydiff.com"

# ── Document retention ───────────────────────────────────────────
# Default retention period in days (0 = no auto-delete)
DEFAULT_RETENTION_DAYS=90

# ── Encryption ───────────────────────────────────────────────────
# 32-byte hex key for AES-256 encryption at rest
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
